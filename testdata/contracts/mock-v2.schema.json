{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spoke.sh/terraform-provider/mock-v2.schema.json",
  "title": "Provisional mock-v2 management protocol; not a published platform API",
  "$defs": {
    "Project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
        "organization_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "organization_id",
        "name"
      ],
      "additionalProperties": false
    },
    "Environment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
        "organization_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "organization_id",
        "project_id",
        "name"
      ],
      "additionalProperties": false
    },
    "BucketSpec": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        },
        "deletion_protection": {
          "type": "boolean"
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "permission": {
          "enum": [
            "read",
            "manage"
          ]
        }
      },
      "required": [
        "name",
        "deletion_protection"
      ],
      "additionalProperties": false
    },
    "Bucket": {
      "type": "object",
      "properties": {
        "organization_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^([a-zA-Z0-9][a-zA-Z0-9_-]{0,127})?$"
        },
        "environment_id": {
          "type": "string",
          "pattern": "^([a-zA-Z0-9][a-zA-Z0-9_-]{0,127})?$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        },
        "deletion_protection": {
          "type": "boolean"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
        "management_key": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "owner_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        }
      },
      "required": [
        "organization_id",
        "project_id",
        "environment_id",
        "name",
        "deletion_protection",
        "id",
        "management_key",
        "revision",
        "owner_id"
      ],
      "additionalProperties": false
    },
    "Operation": {
      "type": "object",
      "properties": {
        "organization_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^([a-zA-Z0-9][a-zA-Z0-9_-]{0,127})?$"
        },
        "environment_id": {
          "type": "string",
          "pattern": "^([a-zA-Z0-9][a-zA-Z0-9_-]{0,127})?$"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
        "management_key": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "create",
            "update",
            "delete"
          ]
        },
        "target_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "accepted",
            "succeeded",
            "failed"
          ]
        },
        "error_code": {
          "type": "string",
          "minLength": 1
        },
        "owner_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
        "resource_kind": {
          "enum": [
            "bucket",
            "project",
            "environment",
            "service_account",
            "grant"
          ]
        }
      },
      "required": [
        "organization_id",
        "project_id",
        "environment_id",
        "id",
        "management_key",
        "fingerprint",
        "kind",
        "target_id",
        "generation",
        "status",
        "owner_id",
        "resource_kind"
      ],
      "additionalProperties": false
    },
    "Mutation": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "create",
            "update",
            "delete"
          ]
        },
        "management_key": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
        "target_id": {
          "type": "string"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "expected_generation": {
          "type": "integer",
          "minimum": 0
        },
        "spec": {
          "$ref": "#/$defs/BucketSpec"
        },
        "resource_kind": {
          "enum": [
            "bucket",
            "project",
            "environment",
            "service_account",
            "grant"
          ]
        }
      },
      "required": [
        "kind",
        "management_key",
        "target_id",
        "expected_revision",
        "expected_generation"
      ],
      "additionalProperties": false
    },
    "Management": {
      "type": "object",
      "properties": {
        "organization_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^([a-zA-Z0-9][a-zA-Z0-9_-]{0,127})?$"
        },
        "environment_id": {
          "type": "string",
          "pattern": "^([a-zA-Z0-9][a-zA-Z0-9_-]{0,127})?$"
        },
        "management_key": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "resource_id": {
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/Operation"
        },
        "owner_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
        "resource_kind": {
          "enum": [
            "bucket",
            "project",
            "environment",
            "service_account",
            "grant"
          ]
        }
      },
      "required": [
        "organization_id",
        "project_id",
        "environment_id",
        "management_key",
        "generation",
        "resource_id",
        "operation",
        "owner_id",
        "resource_kind"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code"
      ],
      "additionalProperties": false
    },
    "Object": {
      "type": "object",
      "properties": {
        "organization_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^([a-zA-Z0-9][a-zA-Z0-9_-]{0,127})?$"
        },
        "environment_id": {
          "type": "string",
          "pattern": "^([a-zA-Z0-9][a-zA-Z0-9_-]{0,127})?$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        },
        "deletion_protection": {
          "type": "boolean"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
        "management_key": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "owner_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "permission": {
          "enum": [
            "read",
            "manage"
          ]
        },
        "resource_kind": {
          "enum": [
            "bucket",
            "project",
            "environment",
            "service_account",
            "grant"
          ]
        }
      },
      "required": [
        "organization_id",
        "project_id",
        "environment_id",
        "name",
        "deletion_protection",
        "id",
        "management_key",
        "revision",
        "owner_id",
        "resource_kind"
      ],
      "additionalProperties": false
    },
    "Capabilities": {
      "type": "object",
      "properties": {
        "organization_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^([a-zA-Z0-9][a-zA-Z0-9_-]{0,127})?$"
        },
        "environment_id": {
          "type": "string",
          "pattern": "^([a-zA-Z0-9][a-zA-Z0-9_-]{0,127})?$"
        },
        "version": {
          "const": "mock-v2"
        },
        "principal_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
        "resources": {
          "type": "array",
          "items": {
            "enum": [
              "bucket",
              "project",
              "environment",
              "service_account",
              "grant"
            ]
          },
          "uniqueItems": true
        },
        "receipt_policy": {
          "const": "retain-or-tombstone"
        }
      },
      "required": [
        "organization_id",
        "project_id",
        "environment_id",
        "version",
        "principal_id",
        "resources",
        "receipt_policy"
      ],
      "additionalProperties": false
    },
    "Page": {
      "type": "object",
      "properties": {
        "organization_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
        "project_id": {
          "type": "string",
          "pattern": "^([a-zA-Z0-9][a-zA-Z0-9_-]{0,127})?$"
        },
        "environment_id": {
          "type": "string",
          "pattern": "^([a-zA-Z0-9][a-zA-Z0-9_-]{0,127})?$"
        },
        "resource_kind": {
          "enum": [
            "bucket",
            "project",
            "environment",
            "service_account",
            "grant"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Object"
          }
        },
        "next_token": {
          "type": "string",
          "maxLength": 2048
        },
        "complete": {
          "type": "boolean"
        },
        "snapshot": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "organization_id",
        "project_id",
        "environment_id",
        "resource_kind",
        "items",
        "next_token",
        "complete",
        "snapshot"
      ],
      "additionalProperties": false
    }
  }
}
