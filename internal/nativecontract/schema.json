{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.spoke.sh/contracts/management-native-v2.schema.json",
  "title": "Spoke native v2 metadata management boundary",
  "description": "Platform-owned source contract; source URL is not a hosted API claim. Binary intents and Serving transport are specified in management-native-v2.md. Root validates signed observation requests. Other envelopes are named definitions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "read",
    "proof"
  ],
  "properties": {
    "read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "limit",
        "scope",
        "kind",
        "key",
        "generation",
        "bucket",
        "after",
        "revision",
        "cursor"
      ],
      "properties": {
        "version": {
          "const": 2
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "organization",
            "project",
            "environment"
          ],
          "properties": {
            "organization": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "project": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "environment": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            }
          }
        },
        "kind": {
          "enum": [
            "capabilities",
            "management",
            "receipt",
            "bucket",
            "pending",
            "buckets"
          ]
        },
        "key": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "bucket": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "cursor": {
          "type": "array",
          "minItems": 32,
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "signature"
      ],
      "properties": {
        "claim": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "definition",
            "realm",
            "principal",
            "credential_epoch",
            "role",
            "audience",
            "context"
          ],
          "properties": {
            "definition": {
              "const": "8e441078693f1373d69323bfeadd5cfe8c7024ec2015819bacfb2b04eaea3865"
            },
            "realm": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "principal": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "credential_epoch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "audience": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "role": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "context": {
              "type": "array",
              "minItems": 32,
              "maxItems": 32,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            }
          }
        },
        "signature": {
          "type": "array",
          "minItems": 64,
          "maxItems": 64,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        }
      }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "generation",
        "revision",
        "bucket",
        "operation",
        "pending",
        "deleted",
        "protection",
        "name",
        "key",
        "capacity_bytes",
        "retention_days",
        "outcome"
      ],
      "properties": {
        "owner": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "bucket": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "operation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "pending": {
          "type": "boolean"
        },
        "deleted": {
          "type": "boolean"
        },
        "protection": {
          "type": "boolean"
        },
        "name": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "key": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "capacity_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "retention_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36500
        },
        "outcome": {
          "enum": [
            "pending",
            "succeeded",
            "authorization_denied",
            "expired"
          ]
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "operation",
        "correlation",
        "input",
        "intent",
        "result"
      ],
      "properties": {
        "owner": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "operation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "correlation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "input": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "intent": {
          "type": "array",
          "minItems": 64,
          "maxItems": 64,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "result": {
          "$ref": "#/$defs/record"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "cloud_effects",
        "import_existing_owner",
        "adoption",
        "transfer",
        "expiry",
        "max_name_bytes",
        "max_command_bytes",
        "max_callers",
        "max_page_items",
        "max_active_operations",
        "bucket_quota",
        "retention",
        "storage_settings",
        "object_listing",
        "max_capacity_bytes",
        "max_retention_days",
        "resource_kinds",
        "runtime_ready"
      ],
      "properties": {
        "adapter": {
          "const": "bucket_metadata"
        },
        "cloud_effects": {
          "const": false
        },
        "import_existing_owner": {
          "const": true
        },
        "adoption": {
          "const": false
        },
        "transfer": {
          "const": false
        },
        "expiry": {
          "const": true
        },
        "max_name_bytes": {
          "const": 16
        },
        "max_command_bytes": {
          "const": 64
        },
        "max_callers": {
          "const": 32
        },
        "max_page_items": {
          "const": 8
        },
        "max_active_operations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "bucket_quota": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "retention": {
          "const": "retain_or_tombstone"
        },
        "storage_settings": {
          "const": true
        },
        "object_listing": {
          "const": true
        },
        "max_capacity_bytes": {
          "const": 9007199254740991
        },
        "max_retention_days": {
          "const": 36500
        },
        "resource_kinds": {
          "const": "bucket"
        },
        "runtime_ready": {
          "const": false
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "scope",
        "revision",
        "record",
        "receipt",
        "pending",
        "buckets",
        "cursor",
        "next",
        "complete",
        "capabilities"
      ],
      "properties": {
        "version": {
          "const": "spoke.management.native.v2"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "organization",
            "project",
            "environment"
          ],
          "properties": {
            "organization": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "project": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "environment": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            }
          }
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/record"
            },
            {
              "type": "null"
            }
          ]
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/receipt"
            },
            {
              "type": "null"
            }
          ]
        },
        "pending": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/receipt"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "buckets": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/record"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "cursor": {
          "type": "array",
          "minItems": 32,
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "next": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "complete": {
          "type": "boolean"
        },
        "capabilities": {
          "anyOf": [
            {
              "$ref": "#/$defs/capabilities"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "string",
          "enum": [
            "InvalidManagementRead",
            "IncompatibleManagementVersion",
            "ServingDenied",
            "AccessDenied",
            "StaleAuthorizationCredential",
            "InvalidSignature",
            "ManagementNotFound",
            "BucketNotFound",
            "ReceiptExpired",
            "ReceiptUnavailable",
            "StaleCursor",
            "ServiceReadConflict",
            "ResourceUnavailable",
            "ServiceUnpublished",
            "ServingCallerCapacity",
            "unsupported_credential"
          ]
        }
      }
    }
  }
}
